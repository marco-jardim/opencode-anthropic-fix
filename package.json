{
  "name": "opencode-anthropic-fix",
  "version": "0.5.0",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-jardim/opencode-anthropic-fix.git"
  },
  "homepage": "https://github.com/marco-jardim/opencode-anthropic-fix#readme",
  "bugs": {
    "url": "https://github.com/marco-jardim/opencode-anthropic-fix/issues"
  },
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "cli.mjs",
    "lib/**/*.mjs",
    "!lib/**/*.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:link": "node scripts/install.mjs link",
    "install:copy": "npm run build && node scripts/install.mjs copy",
    "uninstall": "node scripts/install.mjs uninstall",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.mjs": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode-ai/plugin": "^1.2.27",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@tormentalabs/claude-code-wire-compat": "latest"
  }
}
